{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    // No declarationMap: `src` is not published, so declaration maps would point at files the
    // consumer does not have. The JS sourcemap is self-contained (it embeds sourcesContent).
    "declarationMap": false,
    "declarationDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.stories.tsx"]
}
